<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />

    <!-- Default title / description (replaced server-side by api/render.js per tenant) -->
    <title>Graduate Futures Institute</title>
    <meta name="description" content="We believe that all students and graduates deserve high quality careers and employability provision at every stage of their journey, and that this work benefits individuals, employers and society." />

    <!-- Favicons (static so crawlers see them; dynamic-favicon swap is preserved for logged-in SPA users) -->
    <link rel="icon" type="image/png" sizes="32x32" href="https://lvmzliemqnieeoruhkik.supabase.co/storage/v1/object/public/file-repository/uploads/1767909733211-xza2ojg-fgifavicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="https://lvmzliemqnieeoruhkik.supabase.co/storage/v1/object/public/file-repository/uploads/1767909733211-xza2ojg-fgifavicon.png" id="dynamic-favicon" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Open Graph (defaults; tenant SSR handler overrides these) -->
    <meta property="og:site_name" content="Graduate Futures Institute" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Graduate Futures Institute" />
    <meta property="og:description" content="We believe that all students and graduates deserve high quality careers and employability provision at every stage of their journey, and that this work benefits individuals, employers and society." />
    <meta property="og:image" content="https://www.graduatefutures.org/api/og-image?url=https%3A%2F%2Fvault.iconn.app%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ffile-repository%2Fuploads%2F1778082363343-opx6w9r-1769766504490-abk7r7e-26710cf5a_GFIheaderlogo_1_.png" />
    <meta property="og:url" content="https://www.graduatefutures.org/write/MediaUploads/Resources/Research%20students%20and%20research%20staff/Researchers_Matter_July_2021.pdf" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Graduate Futures Institute" />
    <meta name="twitter:description" content="We believe that all students and graduates deserve high quality careers and employability provision at every stage of their journey, and that this work benefits individuals, employers and society." />
    <meta name="twitter:image" content="https://www.graduatefutures.org/api/og-image?url=https%3A%2F%2Fvault.iconn.app%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ffile-repository%2Fuploads%2F1778082363343-opx6w9r-1769766504490-abk7r7e-26710cf5a_GFIheaderlogo_1_.png" />

    <script>
      (function() {
        var el = document.getElementById('dynamic-favicon');
        if (!el) return;
        fetch('/api/public/favicon-url')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data && data.faviconUrl && el.href !== data.faviconUrl) {
              el.href = data.faviconUrl;
            }
          }).catch(function() {});
      })();
    </script>
    <!-- Font Awesome (icon support for Canvas Builder Card icons) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
